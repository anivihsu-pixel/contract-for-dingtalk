# 合同管理系统 演示版环境模板（SQLite，开箱即用）
# 使用方法：cp demo.env.example .env
#
# 演示环境使用 SQLite 本地文件（runtime/data/contract.db），无需安装 MySQL / Redis。
# 首次启动后请用 `php database/generate_secrets.php` 生成强密钥并替换下方占位符。
#
# 演示账号（执行 `php database/seed_demo.php` 后生效）：
#   admin / manager01 / employee01 / finance01 / sales02 / purchase02
#   admin 口令由 seed_demo.php 随机生成并打印；其余账号口令同样随机生成，请查阅 seed 输出。

APP_DEBUG=false
APP_KEY=please_change_me

# === 数据库：演示用 SQLite ===
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=contract_dingtalk
DB_USER=root
DB_PASS=
DB_PREFIX=

# === 缓存：演示用文件缓存 ===
CACHE_TYPE=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# === 钉钉：演示环境不开真实对接 ===
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_APP_URL=
DINGTALK_MOCK_MODE=true

# === JWT（正式上线请用 php database/generate_secrets.php 生成强密钥）===
JWT_SECRET=please_change_me
JWT_TTL=86400
