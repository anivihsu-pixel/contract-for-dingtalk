# ========================================================================
# 合同管理系统 环境变量模板
# 用法：cp .env.example .env 后按实际环境填写；生产环境务必替换所有密钥。
# 生成随机强密钥：php database/generate_secrets.php
# 注意：.env 含敏感信息，禁止提交到版本库、禁止打入发布包。
# ========================================================================

# 调试开关：生产环境必须为 false（避免泄露堆栈与 SQL 日志）
APP_DEBUG=false

# 应用密钥（生产环境请用 generate_secrets.php 生成随机值）
# 安全提示：每个部署环境务必使用 `php think generate_secrets`
# 或 `php database/generate_secrets.php` 生成唯一的 APP_KEY / JWT_SECRET，
# 禁止使用代码库默认的 please_change_me 等固定值，避免密钥可被预测/被跨环境复用。
APP_KEY=please_change_me

# 数据库：mysql（默认，原生生产库）或 sqlite（本地开发兼容，需显式指定）
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=contract_dingtalk
DB_USER=root
DB_PASS=please_change_me
DB_PREFIX=

# 缓存：file 或 redis
CACHE_TYPE=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 钉钉集成（DINGTALK_MOCK_MODE=true 时为本地模拟，不调用真实钉钉）
# C3【安全·出厂默认】示例默认置 false（生产安全）：本地开发调试时才手动改 true，
# 避免生产直接复制 .env.example → Mock 开启 → 免登可被伪造。
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_CORP_ID=
DINGTALK_AGENT_ID=
DINGTALK_APP_URL=
DINGTALK_MOCK_MODE=false

# JWT（生产环境请用 generate_secrets.php 生成随机值）
# 安全提示：JWT_SECRET 必须每个部署唯一且长度≥32，禁止沿用代码库默认固定值，
# 否则攻击者可伪造任意用户令牌。请用 generate_secrets.php 生成后写入 .env。
JWT_SECRET=please_change_me
JWT_TTL=86400

# Cookie 安全（REV-16）：生产 HTTPS 部署务必设为 true，避免会话 Cookie 在明文链路被截获；
# 本地 HTTP 开发保持 false。会话 Cookie 与 CSRF Cookie 均受此控制。
COOKIE_SECURE=false
