{
    "name": "app/contract-dingtalk",
    "description": "DingTalk Contract Management System - ThinkPHP 8.1",
    "type": "project",
    "license": "proprietary",
    "keywords": ["thinkphp", "dingtalk", "contract"],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.1.4",
        "topthink/think-multi-app": "^1.0",
        "topthink/think-view": "^2.0.5",
        "topthink/think-helper": "^3.0",
        "vlucas/phpdotenv": "^5.0",
        "predis/predis": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.62"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "files": ["app/common.php"]
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
